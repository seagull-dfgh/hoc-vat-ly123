        function updateAnsweredCount() {
            const allParts = examsData[currentExamId].parts;
            let totalAnswered = 0;
            let totalQuestions = 0;

            for (let partKey in allParts) {
                allParts[partKey].forEach(q => {
                    totalQuestions++;
                    const ans = userAnswers[currentExamId][q.id];
                    if (ans !== undefined && ans !== '') {
                        totalAnswered++;
                    }
                });
            }

            document.getElementById('answered-badge').innerText = `Đã làm: ${totalAnswered}/${totalQuestions}`;
            
            // Cập nhật câu động viên nhỏ ở Sidebar theo tiến độ làm bài
            const tipEl = document.getElementById('sidebar-mascot-tip');
            if (!isSubmitted) {
                if (totalAnswered === 0) {
                    tipEl.innerText = `"Cố lên nha! Đọc kỹ đề và chọn đáp án tự tin nhất nhé!"`;
                } else if (totalAnswered < 35) {
                    tipEl.innerText = `"Bạn đang làm tốt lắm! Tiếp tục chinh phục từng câu nhé!"`;
                } else if (totalAnswered < 70) {
                    tipEl.innerText = `"Wow, hơn nửa chặng đường rồi! Cố gắng về đích nha!"`;
                } else {
                    tipEl.innerText = `"Wow, perfect nha! Bạn đã hoàn thành tất cả 70 câu, bấm Nộp Bài thôi!"`;
                }
            }
        }

        // Submit, Grade, Analyze Weakest Section & Generate Encouragement
        function submitExam() {
            if (isSubmitted) {
                showCustomModal('🍋', 'Bé Chanh nhắc nhẹ', 'Bạn đã nộp bài rồi! Hãy xem bảng đánh giá kết quả & phần hướng dẫn giải chi tiết của Bé Bơ ngay trên màn hình nhé.', [
                    { text: 'Đã hiểu', className: 'px-5 py-2.5 rounded-xl bg-emerald-600 text-white font-extrabold text-xs' }
                ]);
                return;
            }

            isSubmitted = true;
            submittedViewMode = 'all';
            pauseTimer();

            let totalScore = 0;
            let correctCount = 0;
            let totalQuestions = 0;
            const partScores = { part1: 0, part2: 0, part3: 0, part4: 0 };
            const partWrongCounts = { part1: 0, part2: 0, part3: 0, part4: 0 };

            const currentAnswers = userAnswers[currentExamId];
            const examParts = examsData[currentExamId].parts;

            for (let partKey in examParts) {
                examParts[partKey].forEach(q => {
                    totalQuestions++;
                    const uAns = currentAnswers[q.id];
                    let isCorrect = false;

                    if (partKey === 'part4') {
                        if (uAns && uAns.toString().trim().toLowerCase() === q.correct.toString().trim().toLowerCase()) {
                            isCorrect = true;
                        }
                    } else {
                        if (uAns === q.correct) {
                            isCorrect = true;
                        }
                    }

                    if (isCorrect) {
                        correctCount++;
                        totalScore += q.points;
                        partScores[partKey] += q.points;
                    } else {
                        partWrongCounts[partKey]++;
                    }
                });
            }

            // Phân tích phần làm sai nhiều nhất
            let maxWrong = -1;
            let weakestPartKey = 'part1';
            for (let p in partWrongCounts) {
                if (partWrongCounts[p] > maxWrong) {
                    maxWrong = partWrongCounts[p];
                    weakestPartKey = p;
                }
            }

            // Gợi ý ôn tập tương ứng
            const weakestDetails = {
                part1: {
                    title: `Phần 1: Nhận Biết - Thông Hiểu (Sai ${partWrongCounts.part1}/20 câu)`,
                    advice: "Bạn cần xem lại định nghĩa, khái niệm cơ bản và học thuộc lòng các công thức nền tảng trong PHẦN A. Hãy tập trung chú ý các đơn vị đo chuẩn trong hệ SI!"
                },
                part2: {
                    title: `Phần 2: Vận Dụng (Sai ${partWrongCounts.part2}/20 câu)`,
                    advice: "Bạn nên rèn luyện kỹ năng biến đổi linh hoạt các công thức, làm thêm bài tập áp dụng vào các hiện tượng thực tế đơn giản trong cuộc sống hàng ngày."
                },
                part3: {
                    title: `Phần 3: Vận Dụng Cao (Sai ${partWrongCounts.part3}/20 câu)`,
                    advice: "Hãy rèn luyện tư duy tổng hợp bài toán đa bước, liên kết nhiều khái niệm (điện, cơ, nhiệt) thành một hệ thống hoàn chỉnh và kiểm tra kỹ điều kiện bài toán."
                },
                part4: {
                    title: `Phần 4: Trả Lời Ngắn (Sai ${partWrongCounts.part4}/10 câu)`,
                    advice: "Hãy chú ý cẩn thận hơn trong quá trình tính toán số liệu cuối cùng, đổi đúng đơn vị đo (ví dụ: km/h sang m/s, phút sang giây, kW sang W) trước khi bấm đáp số."
                }
            };

            document.getElementById('weakest-section-title').innerText = weakestDetails[weakestPartKey].title;
            document.getElementById('weakest-section-advice').innerText = weakestDetails[weakestPartKey].advice;

            // Lời động viên của Bé Chanh Vàng theo mức điểm
            let encouragement = "";
            if (totalScore >= 350) {
                encouragement = "Wow, perfect nha! 🌟 Bạn nắm cực kỳ vững kiến thức Vật lý SGK và có khả năng tư duy tuyệt vời. Bé Chanh tự hào về bạn lắm!";
            } else if (totalScore >= 250) {
                encouragement = "Tuyệt vời lắm nha! 👍 Bạn đã hiểu hầu hết kiến thức trọng tâm rồi. Chỉ cần xem lại hướng dẫn của Bé Bơ ở vài câu chưa chính xác là bạn sẽ đạt điểm tối đa!";
            } else if (totalScore >= 150) {
                encouragement = "Khá tốt rồi nè! 💪 Bạn đã có nền tảng cơ bản vững vàng. Hãy dành thêm chút thời gian ôn lại PHẦN A và đọc lời giải chi tiết để bứt phá ở lần sau nha!";
            } else {
                encouragement = "Đừng nản chí nha! ❤️ Vật lý là môn học khám phá tự nhiên cần sự kiên trì. Hãy quay lại PHẦN A đọc lý thuyết & ví dụ cùng Bé Bơ, bạn chắc chắn sẽ tiến bộ vượt bậc!";
            }
            document.getElementById('encouragement-message').innerText = encouragement;
            document.getElementById('sidebar-mascot-tip').innerText = totalScore >= 250 ? `"Wow, perfect nha! Xem chữa bài chi tiết bên trái nhé!"` : `"Đừng nản chí nha! Xem Bé Bơ giải thích từng câu để rút kinh nghiệm nè!"`;

            // Display Results
            document.getElementById('total-score-display').innerText = totalScore;
            document.getElementById('correct-count-display').innerText = `${correctCount}/${totalQuestions}`;
            
            // Time display
            const m = Math.floor(stopwatchSeconds / 60);
            const s = stopwatchSeconds % 60;
            document.getElementById('final-time-display').innerText = `${m}p ${s}s`;

            // Display breakdown scores
            document.getElementById('score-p1').innerText = `${partScores.part1}/100`;
            document.getElementById('score-p2').innerText = `${partScores.part2}/100`;
            document.getElementById('score-p3').innerText = `${partScores.part3}/100`;
            document.getElementById('score-p4').innerText = `${partScores.part4}/100`;

            document.getElementById('result-summary-card').classList.remove('hidden');
            document.getElementById('section-score-breakdown').classList.remove('hidden');
            document.getElementById('post-submit-filter-bar').classList.remove('hidden');
            document.getElementById('part-bottom-navigation').classList.add('hidden');

            updateSidebarPills();
            updatePostSubmitFilterButtons();
            renderQuestions();
            renderSidebarGrid();

            document.getElementById('result-summary-card').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function scrollToQuestions() {
            document.getElementById('questions-wrapper').scrollIntoView({ behavior: 'smooth' });
        }

        function resetCurrentExam() {
            showCustomModal('🍋', 'Làm lại đề kiểm tra?', 'Bé Chanh hỏi bạn: Bạn có chắc chắn muốn xóa các đáp án hiện tại và làm lại đề kiểm tra này từ Phần 1 không?', [
                { text: 'Hủy bỏ', className: 'px-4 py-2 rounded-xl bg-slate-100 text-slate-700 font-bold text-xs' },
                { 
                    text: 'Đồng ý làm lại', 
                    className: 'px-5 py-2 rounded-xl bg-emerald-600 text-white font-extrabold text-xs shadow-sm',
                    onClick: () => {
                        userAnswers[currentExamId] = {};
                        isSubmitted = false;
                        currentTab = 'part1';
                        document.getElementById('result-summary-card').classList.add('hidden');
                        document.getElementById('section-score-breakdown').classList.add('hidden');
                        document.getElementById('post-submit-filter-bar').classList.add('hidden');
                        document.getElementById('part-bottom-navigation').classList.remove('hidden');
                        resetTimer();
                        startTimer();
                        loadExam(currentExamId);
                    }
                }
            ]);
        }
    </script>
