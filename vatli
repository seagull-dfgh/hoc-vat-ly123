<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PhysicLab - Chinh Phục Vật Lý Cùng Bé Chanh & Bé Bơ</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        theme: {
                            yellowLight: '#FEFCE8',
                            yellowSoft: '#FEF9C3',
                            yellowBright: '#FEF08A',
                            amber: '#EAB308',
                            amberDark: '#CA8A04',
                            emerald: '#10B981',
                            emeraldDark: '#059669',
                            sky: '#0EA5E9',
                            skyDark: '#0284C7'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts: Plus Jakarta Sans (Dạng vuông hiện đại, cứng cáp) -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: linear-gradient(180deg, #FEFCE8 0%, #F0FDF4 380px, #F8FAFC 100%);
            letter-spacing: -0.01em;
        }
        .custom-scrollbar::-webkit-scrollbar { width: 8px; height: 8px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #FEFCE8; border-radius: 8px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #A7F3D0; border-radius: 8px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #10B981; }
        
        /* High contrast result styles */
        .ans-correct {
            background-color: #D1FAE5 !important;
            border: 2.5px solid #059669 !important;
            color: #064E3B !important;
        }
        .ans-wrong {
            background-color: #FEE2E2 !important;
            border: 2.5px solid #DC2626 !important;
            color: #7F1D1D !important;
        }

        /* Floating mascot animation */
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-6px); }
        }
        .mascot-float {
            animation: floatSlow 3s ease-in-out infinite;
        }
    </style>
</head>
<body class="text-slate-700 min-h-screen flex flex-col font-medium selection:bg-emerald-200 selection:text-emerald-950">

    <!-- Top Navigation Header -->
    <header class="bg-white/95 backdrop-blur-md sticky top-0 z-50 shadow-xs border-b-2 border-emerald-200/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-wrap items-center justify-between py-3 sm:h-20 gap-3">
                
                <!-- Logo & Brand (Đã bỏ dòng Đồng hành cùng...) -->
                <div class="flex items-center space-x-3 cursor-pointer" onclick="scrollToTop()">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-emerald-500 via-sky-500 to-yellow-300 flex items-center justify-center text-white text-2xl shadow-md shadow-emerald-500/20 border border-emerald-300">
                        <span class="text-2xl drop-shadow-xs">🍋</span>
                    </div>
                    <div class="flex flex-col justify-center">
                        <div class="text-2xl sm:text-3xl font-black tracking-tight text-slate-800 leading-none">
                            Chinh Phục <span class="text-sky-600">Vật</span><span class="text-emerald-600"> Lý</span>
                        </div>
                    </div>
                </div>

                <!-- Main Switcher: PHẦN A / PHẦN B -->
                <div class="flex bg-emerald-50/90 p-1.5 rounded-2xl border border-emerald-200">
                    <button onclick="switchMainSection('sectionA')" id="nav-btn-secA" class="px-4 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all duration-200 bg-emerald-600 text-white shadow-md shadow-emerald-600/20">
                        <i class="fa-solid fa-book-open mr-1.5"></i> PHẦN A: KIẾN THỨC CẦN ÔN
                    </button>
                    <button onclick="switchMainSection('sectionB')" id="nav-btn-secB" class="px-4 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all duration-200 text-emerald-900 hover:bg-white/90">
                        <i class="fa-solid fa-pen-ruler mr-1.5 text-sky-600"></i> PHẦN B: CÁC ĐỀ KIỂM TRA
                    </button>
                </div>

            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- ========================================================================= -->
        <!-- PHẦN A: KIẾN THỨC CẦN ÔN                                                 -->
        <!-- ========================================================================= -->
        <section id="main-section-A" class="space-y-8">
            
            <!-- Hero Banner Hài Hòa Vàng Nhạt + Xanh Lá + Xanh Dương -->
            <div class="bg-gradient-to-br from-yellow-50 via-emerald-50 to-sky-100 rounded-3xl p-7 sm:p-10 text-slate-800 shadow-md shadow-emerald-200/40 relative overflow-hidden border-2 border-emerald-200">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center relative z-10">
                    <div class="lg:col-span-8">
                        <div class="inline-flex items-center space-x-2 px-4 py-1.5 bg-white/90 backdrop-blur-md border border-emerald-300 text-emerald-800 font-extrabold rounded-full text-xs uppercase tracking-wider mb-4 shadow-xs">
                            <i class="fa-solid fa-bolt text-yellow-500"></i>
                            <span>Nền tảng Vật lý chuẩn SGK 2018 (THCS & THPT)</span>
                        </div>
                        <h1 class="text-3xl sm:text-5xl font-black mb-4 tracking-tight leading-tight text-slate-800">
                            Chinh Phục <span class="text-sky-600">Vật Lý</span> <br class="hidden sm:inline"/>
                            <span class="text-emerald-600">Dễ Dàng</span> & <span class="text-yellow-600">Sâu Sắc</span>
                        </h1>
                        <p class="text-base sm:text-lg font-semibold text-slate-700 leading-relaxed">
                            Hệ thống tóm tắt lý thuyết, công thức trọng tâm và ví dụ minh họa thực tế gắn liền với đời sống cùng đôi bạn <strong class="text-yellow-700">Bé Chanh Vàng</strong> & <strong class="text-emerald-700">Bé Bơ Xanh</strong>!
                        </p>
                    </div>

                    <!-- Mascot Cards Showcase -->
                    <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3">
                        <div class="bg-white/95 backdrop-blur-md p-4 rounded-2xl border-2 border-yellow-200 shadow-xs flex items-center space-x-3 mascot-float">
                            <div class="w-12 h-12 rounded-2xl bg-yellow-50 flex items-center justify-center text-3xl shrink-0 border border-yellow-200">🍋</div>
                            <div>
                                <div class="text-xs font-black text-yellow-700 uppercase">Bé Chanh Vàng</div>
                                <div class="text-xs font-bold text-slate-700">"Cố lên nha, bạn làm được mà! Wow, perfect nha!"</div>
                            </div>
                        </div>
                        <div class="bg-white/95 backdrop-blur-md p-4 rounded-2xl border-2 border-emerald-200 shadow-xs flex items-center space-x-3">
                            <div class="w-12 h-12 rounded-2xl bg-emerald-50 flex items-center justify-center text-3xl shrink-0 border border-emerald-200">🥑</div>
                            <div>
                                <div class="text-xs font-black text-emerald-700 uppercase">Bé Bơ Xanh</div>
                                <div class="text-xs font-bold text-slate-700">"Tớ sẽ chỉ dẫn từng bước và ví dụ thực tế cực dễ hiểu!"</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Theory Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                <!-- Topic 1 -->
                <div class="bg-white rounded-3xl p-6 shadow-xs border-2 border-emerald-100 hover:border-emerald-400 hover:shadow-md transition duration-200">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-2xl font-black">
                            <i class="fa-solid fa-car"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-extrabold text-slate-800">1. CƠ HỌC</h3>
                            <p class="text-xs font-bold text-slate-400">Chuyển động & Lực</p>
                        </div>
                    </div>
                    <div class="space-y-3 text-sm">
                        <div class="bg-yellow-50/70 p-3 rounded-2xl border border-yellow-200/70">
                            <span class="font-bold text-slate-700 block mb-1">Vận tốc & Gia tốc:</span>
                            <div class="font-mono text-xs font-extrabold text-emerald-700 bg-white p-2 rounded-xl text-center border border-emerald-200">v = s / t  |  a = (v - v₀) / t</div>
                        </div>
                        <div class="bg-emerald-50/70 p-3.5 rounded-2xl border border-emerald-200/70">
                            <span class="font-extrabold text-emerald-800 text-xs flex items-center mb-1">
                                <span class="mr-1.5 text-base">🥑</span> Bé Bơ lấy ví dụ thực tế:
                            </span>
                            <p class="text-xs text-slate-700 leading-relaxed font-medium">
                                Khi đi ô tô gặp chướng ngại vật khẩn cấp, thời gian phản ứng + quãng đường phanh xác định khoảng cách an toàn. Xe chạy càng nhanh thì quãng đường phanh tăng gấp bình phương vận tốc.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Topic 2 -->
                <div class="bg-white rounded-3xl p-6 shadow-xs border-2 border-sky-100 hover:border-sky-400 hover:shadow-md transition duration-200">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-sky-100 text-sky-600 flex items-center justify-center text-2xl font-black">
                            <i class="fa-solid fa-plug"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-extrabold text-slate-800">2. ĐIỆN HỌC</h3>
                            <p class="text-xs font-bold text-slate-400">Mạch điện & Định luật Ôm</p>
                        </div>
                    </div>
                    <div class="space-y-3 text-sm">
                        <div class="bg-yellow-50/70 p-3 rounded-2xl border border-yellow-200/70">
                            <span class="font-bold text-slate-700 block mb-1">Định luật Ôm & Công suất:</span>
                            <div class="font-mono text-xs font-extrabold text-sky-700 bg-white p-2 rounded-xl text-center border border-sky-200">I = U / R  |  P = U . I = I² . R</div>
                        </div>
                        <div class="bg-sky-50/70 p-3.5 rounded-2xl border border-sky-200/70">
                            <span class="font-extrabold text-sky-800 text-xs flex items-center mb-1">
                                <span class="mr-1.5 text-base">🥑</span> Bé Bơ lấy ví dụ thực tế:
                            </span>
                            <p class="text-xs text-slate-700 leading-relaxed font-medium">
                                Cầu chì hoặc aptomat tự động ngắt mạch khi dòng điện I vượt quá ngưỡng an toàn để phòng tránh cháy nổ do hiện tượng tỏa nhiệt Q = I²Rt quá cao trên đường dây.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Topic 3 -->
                <div class="bg-white rounded-3xl p-6 shadow-xs border-2 border-yellow-200/80 hover:border-yellow-400 hover:shadow-md transition duration-200">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-yellow-100 text-yellow-700 flex items-center justify-center text-2xl font-black">
                            <i class="fa-solid fa-fire-flame-curved"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-extrabold text-slate-800">3. NHIỆT HỌC</h3>
                            <p class="text-xs font-bold text-slate-400">Nhiệt lượng & Cân bằng nhiệt</p>
                        </div>
                    </div>
                    <div class="space-y-3 text-sm">
                        <div class="bg-yellow-50/70 p-3 rounded-2xl border border-yellow-200/70">
                            <span class="font-bold text-slate-700 block mb-1">Nhiệt lượng & Cân bằng:</span>
                            <div class="font-mono text-xs font-extrabold text-yellow-800 bg-white p-2 rounded-xl text-center border border-yellow-200">Q = m.c.Δt  |  Q tỏa = Q thu</div>
                        </div>
                        <div class="bg-emerald-50/70 p-3.5 rounded-2xl border border-emerald-200/70">
                            <span class="font-extrabold text-emerald-800 text-xs flex items-center mb-1">
                                <span class="mr-1.5 text-base">🥑</span> Bé Bơ lấy ví dụ thực tế:
                            </span>
                            <p class="text-xs text-slate-700 leading-relaxed font-medium">
                                Nước biển hạ nhiệt chậm hơn đất liền vào ban đêm vì nước có nhiệt dung riêng c rất lớn (4200 J/kg.K), giúp điều hòa không khí vùng duyên hải.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Topic 4 -->
                <div class="bg-white rounded-3xl p-6 shadow-xs border-2 border-sky-100 hover:border-sky-400 hover:shadow-md transition duration-200">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-sky-100 text-sky-600 flex items-center justify-center text-2xl font-black">
                            <i class="fa-solid fa-eye"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-extrabold text-slate-800">4. QUANG HỌC</h3>
                            <p class="text-xs font-bold text-slate-400">Khúc xạ & Thấu kính</p>
                        </div>
                    </div>
                    <div class="space-y-3 text-sm">
                        <div class="bg-yellow-50/70 p-3 rounded-2xl border border-yellow-200/70">
                            <span class="font-bold text-slate-700 block mb-1">Công thức thấu kính:</span>
                            <div class="font-mono text-xs font-extrabold text-sky-700 bg-white p-2 rounded-xl text-center border border-sky-200">1/f = 1/d + 1/d'  |  k = -d'/d</div>
                        </div>
                        <div class="bg-sky-50/70 p-3.5 rounded-2xl border border-sky-200/70">
                            <span class="font-extrabold text-sky-800 text-xs flex items-center mb-1">
                                <span class="mr-1.5 text-base">🥑</span> Bé Bơ lấy ví dụ thực tế:
                            </span>
                            <p class="text-xs text-slate-700 leading-relaxed font-medium">
                                Người bị cận thị đeo thấu kính phân kỳ để tạo ảnh ảo nằm trong giới hạn nhìn rõ của mắt, giúp nhìn rõ các vật ở xa như bảng viết trên lớp.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Topic 5 -->
                <div class="bg-white rounded-3xl p-6 shadow-xs border-2 border-emerald-100 hover:border-emerald-400 hover:shadow-md transition duration-200">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-2xl font-black">
                            <i class="fa-solid fa-wave-square"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-extrabold text-slate-800">5. DAO ĐỘNG & SÓNG</h3>
                            <p class="text-xs font-bold text-slate-400">Chu kỳ, Tần số & Sóng âm</p>
                        </div>
                    </div>
                    <div class="space-y-3 text-sm">
                        <div class="bg-yellow-50/70 p-3 rounded-2xl border border-yellow-200/70">
                            <span class="font-bold text-slate-700 block mb-1">Bước sóng & Tần số:</span>
                            <div class="font-mono text-xs font-extrabold text-emerald-700 bg-white p-2 rounded-xl text-center border border-emerald-200">λ = v . T = v / f</div>
                        </div>
                        <div class="bg-emerald-50/70 p-3.5 rounded-2xl border border-emerald-200/70">
                            <span class="font-extrabold text-emerald-800 text-xs flex items-center mb-1">
                                <span class="mr-1.5 text-base">🥑</span> Bé Bơ lấy ví dụ thực tế:
                            </span>
                            <p class="text-xs text-slate-700 leading-relaxed font-medium">
                                Dơi và cá heo phát ra sóng siêu âm (tần số > 20.000 Hz) và thu nhận sóng phản xạ để định vị con mồi và chướng ngại vật trong bóng tối.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Topic 6 -->
                <div class="bg-white rounded-3xl p-6 shadow-xs border-2 border-yellow-200/80 hover:border-yellow-400 hover:shadow-md transition duration-200">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-yellow-100 text-yellow-700 flex items-center justify-center text-2xl font-black">
                            <i class="fa-solid fa-sun"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-extrabold text-slate-800">6. NĂNG LƯỢNG & BẢO TOÀN</h3>
                            <p class="text-xs font-bold text-slate-400">Cơ năng & Hiệu suất</p>
                        </div>
                    </div>
                    <div class="space-y-3 text-sm">
                        <div class="bg-yellow-50/70 p-3 rounded-2xl border border-yellow-200/70">
                            <span class="font-bold text-slate-700 block mb-1">Cơ năng & Hiệu suất:</span>
                            <div class="font-mono text-xs font-extrabold text-yellow-800 bg-white p-2 rounded-xl text-center border border-yellow-200">W = Wđ + Wt  |  H = (Aᵢ / Atp).100%</div>
                        </div>
                        <div class="bg-emerald-50/70 p-3.5 rounded-2xl border border-emerald-200/70">
                            <span class="font-extrabold text-emerald-800 text-xs flex items-center mb-1">
                                <span class="mr-1.5 text-base">🥑</span> Bé Bơ lấy ví dụ thực tế:
                            </span>
                            <p class="text-xs text-slate-700 leading-relaxed font-medium">
                                Đập thủy điện tích nước trên cao để dự trữ thế năng trọng trường. Khi xả nước, thế năng chuyển hóa thành động năng làm quay tua-bin phát điện.
                            </p>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Banner CTA Switch to Phần B -->
            <div class="bg-gradient-to-r from-emerald-500 via-teal-500 to-sky-500 rounded-3xl p-6 sm:p-8 text-white flex flex-col sm:flex-row items-center justify-between gap-4 border-2 border-emerald-400 shadow-lg shadow-emerald-500/20">
                <div class="flex items-center space-x-4">
                    <span class="text-4xl bg-yellow-100 w-14 h-14 rounded-2xl flex items-center justify-center shadow-xs shrink-0">🍋</span>
                    <div>
                        <h3 class="text-xl sm:text-2xl font-black text-white">Bé Chanh cổ vũ bạn nè: "Sẵn sàng chưa nào?"</h3>
                        <p class="text-emerald-50 text-sm font-bold mt-1">Chuyển sang PHẦN B để chinh phục 3 bộ đề kiểm tra chuẩn cấu trúc ngay nhé!</p>
                    </div>
                </div>
                <button onclick="switchMainSection('sectionB')" class="px-8 py-3.5 bg-yellow-200 text-emerald-950 hover:bg-yellow-100 font-black rounded-2xl shadow-md transition transform hover:scale-105 whitespace-nowrap border border-yellow-300">
                    <i class="fa-solid fa-pen-to-square mr-2 text-emerald-700"></i> Sang PHẦN B Làm Bài
                </button>
            </div>

        </section>


        <!-- ========================================================================= -->
        <!-- PHẦN B: CÁC ĐỀ KIỂM TRA                                                  -->
        <!-- ========================================================================= -->
        <section id="main-section-B" class="hidden space-y-6">
            
            <!-- Top Controls Bar -->
            <div class="bg-white rounded-3xl p-5 shadow-xs border-2 border-emerald-200/80 flex flex-wrap items-center justify-between gap-4">
                
                <!-- Select Exams -->
                <div class="flex items-center space-x-2 overflow-x-auto pb-1 sm:pb-0 w-full md:w-auto">
                    <span class="text-xs font-extrabold text-emerald-700 uppercase tracking-wider hidden sm:inline mr-1">Chọn Đề:</span>
                    <button onclick="selectExam(1)" id="exam-btn-1" class="px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-extrabold transition-all bg-emerald-600 text-white shadow-md shadow-emerald-600/20">
                        Đề Số 01
                    </button>
                    <button onclick="selectExam(2)" id="exam-btn-2" class="px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-extrabold transition-all bg-emerald-50 text-emerald-900 hover:bg-emerald-100 border border-emerald-200">
                        Đề Số 02
                    </button>
                    <button onclick="selectExam(3)" id="exam-btn-3" class="px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-extrabold transition-all bg-emerald-50 text-emerald-900 hover:bg-emerald-100 border border-emerald-200">
                        Đề Số 03
                    </button>
                </div>

                <!-- Stopwatch Display (Tính thời gian làm bài) -->
                <div class="flex items-center space-x-3 w-full sm:w-auto justify-between sm:justify-end">
                    <div class="bg-yellow-50/90 border-2 border-yellow-200 px-4 py-2 rounded-2xl flex items-center space-x-3">
                        <i class="fa-solid fa-stopwatch text-emerald-600 text-xl"></i>
                        <div>
                            <div class="text-[10px] text-slate-600 font-extrabold uppercase tracking-wider">Thời gian làm bài</div>
                            <div id="stopwatch-display" class="font-mono text-xl font-black text-slate-800">00:00</div>
                        </div>
                    </div>
                    
                    <button id="btn-toggle-timer" onclick="toggleTimer()" class="p-3 rounded-2xl bg-sky-50 hover:bg-sky-100 text-sky-800 font-bold border border-sky-200 transition" title="Tạm dừng/Tiếp tục">
                        <i id="timer-icon" class="fa-solid fa-pause"></i>
